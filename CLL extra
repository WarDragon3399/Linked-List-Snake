#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;

    Node(int val) : data(val), next(nullptr) {}
};

class CircularLinkedList {
private:
    Node* head_node;

public:
    CircularLinkedList() : head_node(nullptr) {}

    // 1. Insert at End
    void insertAtEnd(int value) {
        Node* new_node = new Node(value);
        if (!head_node) {
            head_node = new_node;
            new_node->next = head_node;
            return;
        }
        Node* temp = head_node;
        while (temp->next != head_node) temp = temp->next;
        temp->next = new_node;
        new_node->next = head_node;
    }

    // 2. Insert at Beginning
    void insertAtBeginning(int value) {
        Node* new_node = new Node(value);
        if (!head_node) {
            head_node = new_node;
            new_node->next = head_node;
            return;
        }
        Node* temp = head_node;
        while (temp->next != head_node) temp = temp->next;
        new_node->next = head_node;
        temp->next = new_node;
        head_node = new_node;
    }

    // 3. Delete from End
    void deleteFromEnd() {
        if (!head_node) return;
        if (head_node->next == head_node) {
            delete head_node;
            head_node = nullptr;
            return;
        }
        Node* temp = head_node;
        while (temp->next->next != head_node) temp = temp->next;
        delete temp->next;
        temp->next = head_node;
    }

    // 4. Delete from Beginning
    void deleteFromBeginning() {
        if (!head_node) return;
        if (head_node->next == head_node) {
            delete head_node;
            head_node = nullptr;
            return;
        }
        Node* last = head_node;
        while (last->next != head_node) last = last->next;
        Node* to_delete = head_node;
        head_node = head_node->next;
        last->next = head_node;
        delete to_delete;
    }

    // 5. Traverse
    void traverse() {
        if (!head_node) {
            cout << "List is empty." << endl;
            return;
        }
        Node* temp = head_node;
        do {
            cout << temp->data << " ";
            temp = temp->next;
        } while (temp != head_node);
        cout << endl;
    }

    // 6. Find the Middle
    void findTheMiddle() {
        if (!head_node) {
            cout << "List is empty." << endl;
            return;
        }
        Node* slow = head_node;
        Node* fast = head_node;
        do {
            fast = fast->next;
            if (fast != head_node) fast = fast->next;
            if (fast != head_node) slow = slow->next;
        } while (fast != head_node);
        cout << "Middle element is: " << slow->data << endl;
    }

    // 7. Insert at Index
    void insertAtIndex(int index, int value) {
        if (index == 0) {
            insertAtBeginning(value);
            return;
        }
        Node* temp = head_node;
        for (int i = 0; i < index - 1 && temp->next != head_node; ++i) {
            temp = temp->next;
        }
        Node* new_node = new Node(value);
        new_node->next = temp->next;
        temp->next = new_node;
    }

    // 8. Delete from Index
    void deleteFromIndex(int index) {
        if (!head_node) return;
        if (index == 0) {
            deleteFromBeginning();
            return;
        }
        Node* temp = head_node;
        for (int i = 0; i < index - 1 && temp->next != head_node; ++i) {
            temp = temp->next;
        }
        Node* to_delete = temp->next;
        temp->next = to_delete->next;
        delete to_delete;
    }

    // 9. Reverse List
    void reverse() {
        if (!head_node || head_node->next == head_node) return;

        Node* prev = nullptr;
        Node* current = head_node;
        Node* next_node = nullptr;
        Node* tail = head_node;

        do {
            next_node = current->next;
            current->next = prev;
            prev = current;
            current = next_node;
        } while (current != head_node);

        tail->next = prev;
        head_node = prev;
    }
};
